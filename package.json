{
  "name": "percolate",
  "version": "0.0.0",
  "description": "",
  "author": "Percolate Text Editor development team",
  "type": "module",
  "main": "out/main/index.cjs",
  "build": {
    "appId": "com.percolate.editor",
    "productName": "Percolate Text Editor",
    "directories": {
      "buildResources": "public"
    },
    "icon": "public/app-icon.png"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "notices": "node scripts/generate-notices.mjs",
    "prebuild:demo": "npm run notices",
    "build:demo": "DEMO=1 vite build --base ./",
    "release:demo": "npm run build:demo",
    "preview:demo": "DEMO=1 vite preview --base ./",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "install-electron && npm run rebuild:native",
    "rebuild:native": "electron-rebuild -f -w node-pty -w better-sqlite3",
    "electron:dev": "AGENT_MODE=stub electron-vite dev",
    "electron:dev:stub": "AGENT_MODE=stub electron-vite dev",
    "electron:dev:online": "AGENT_MODE=online electron-vite dev",
    "electron:preview:stub": "AGENT_MODE=stub electron-vite preview",
    "electron:preview:online": "AGENT_MODE=online electron-vite preview",
    "electron:build": "electron-vite build",
    "electron:preview": "electron-vite preview"
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/better-sqlite3": "^9.6.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "solid-devtools": "^0.34.3",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/openai": "^4.0.83",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.2",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/google-sans-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@platformos/lang-jsonc": "^0.0.17",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.124",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "github-markdown-css": "^5.9.0",
    "lucide-solid": "^1.21.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "node-pty": "^1.1.0",
    "solid-js": "^1.9.5"
  }
}
